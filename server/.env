# Go Backend Server Configuration

# Server Port
PORT=5000

# Google Gemini API Key (Get a FREE key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: AI Model (Defaults to gemini-2.0-flash)
AI_MODEL=gemini-2.0-flash

# Allowed Frontend Origins for CORS Security
# Set to your Vercel URL in production (e.g. https://your-app.vercel.app), or * to allow all
ALLOWED_ORIGINS=*
